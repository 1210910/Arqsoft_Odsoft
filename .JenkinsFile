pipeline {
    agent any

    environment {
        REPO_URL = 'https://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@github.com/1210910/Arqsoft_Odsoft.git'

    }

     stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                git branch: 'main', url: "${REPO_URL}"
            }
        }

        stage('Clean') {
            steps {
                script{
                    echo 'Cleaning wor0kspace...'
                    sh 'mvn clean'
                    // sh 'mvn clean install'
                }
            }
        }

        stage('Validate') {
            steps {
                script{
                    echo 'Validating code...'
                    sh 'mvn validate'
                }
            }
        }

        stage('Build') {
            steps {
                script{

                    echo 'Building the project...'

                    sh 'mvn compile'

                }
            }
        }

        stage('Test') {

                stage('Mutation Testing') {
                    steps {
                        script{

                            echo 'Running Unit Tests...'
                            // Run unit tests
                            sh 'mvn test -Dtest=path/to/your/tests/*'

                        }
                    }
                }

                stage('Unit Testing') {
                    steps {
                        script{

                            echo 'Running Unit Tests...'
                            sh 'mvn test -Dtest=pt.psoft.g1.psoftg1.unitTests. -f pom.xml'

                        }

                    }
                }

                stage('Integration Testing') {
                    steps {
                        script{

                            echo 'Running Integration Tests...'
                            sh 'mvn test -Dtest=pt.psoft.g1.psoftg1.integrationTests. -f pom.xml'

                        }
                    }
        }

        stage('Package') {
            steps {
                echo 'Building the final package...'
                // Example Maven package
                sh 'mvn package'
            }
        }
    /*
        stage('Deploy') {
            steps {
                scripts{

                    sh 'cd target && JENKINS_NODE_COOKIE=dontKillMe && nohup java -java proj-0.0.1-SNAPSHOT.jar '
                }


                echo 'Transferring files and deploying...'
            // alterar isto
            'scp target/your-package.jar user@remote-server:/path/to/deploy/'

            //verificar depois isto
            'ssh user@remote-server "nohup java -jar /path/to/deploy/your-package.jar --server.port=8081 --spring.datasource.url=jdbc:h2:mem:testdb > output.log 2>&1 &"'

            }
        }
        */
    }

    post {
        always {
            echo 'Cleaning up the workspace...'
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}